{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signflow",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://signflow.santatriniainafeno01.workers.dev",
    "B2_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "B2_REGION": "us-east-005",
    "B2_BUCKET": "signflow"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signflow-db",
      // À remplacer par l'identifiant réel après `npx wrangler d1 create signflow-db`
      "database_id": "6c235adb-2adb-4237-8fd6-8cf6246bfff7",
      "migrations_dir": "drizzle/migrations"
    }
  ]
}
